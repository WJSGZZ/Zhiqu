    "08_routes_52": {
      "type": "route_cards",
      "content": {
        "title": "国考：具体职位核完才讨论报名",
        "门槛": "学历学位、专业、应届、经历、政治面貌及其他条件逐一对原文；无职位就不认证能报。",
        "时间窗口": "注册认证截止 {{e:E005#/value|md_hm}}，申请截止 {{e:E003#/value|md_hm}}；公共科目 {{e:E004#/value|md}}。",
        "投入": "通用考试主要是行测、申论；特殊职位专业考试另核。录用性质按正式公告，非企业劳动报价。",
        "切换条件": "无本人愿做且资格可核的职位，或新增准备挤压主线，就暂停；竞争比不作个人概率。"
      },
      "evidence_refs": [
