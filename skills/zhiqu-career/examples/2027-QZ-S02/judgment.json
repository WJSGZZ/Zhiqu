    "11_questions_4": {
      "type": "question_table",
      "content": {
        "columns": [
          "要问什么",
          "去哪里确认",
          "核完怎样改变决定"
        ],
        "rows": [
          [
            "最关键资格与可报范围",
            "本人登记材料与当届正式公告；有疑问用公开咨询渠道",
            "有明确不符则排除具体项；没有答复保持待核"
          ],
          [
            "实际学习或工作内容",
            "培养方案、正式岗位职责；相关人员只补任务线索",
            "愿意长期做且能力可补才进入候选，不凭名称判断"
          ],
          [
            "费用和家庭支持",
            "正式收费表或书面薪酬条件；与家庭确认支持边界",
            "不能持续承担就调学校、地点或时间，不预支未确定资助"
          ],
          [
            "冲突节点与退出条件",
            "官方确认安排、单位通知和本人课程责任",
            "发生冲突时保主线，记录放弃什么，避免默认全部兼得"
          ]
        ]
      },
      "evidence_refs": [
        "E001"
      ]
    },
