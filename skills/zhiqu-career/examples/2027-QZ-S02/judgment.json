    "01_actions_14": {
      "type": "dated_actions",
      "content": {
        "items": [
          {
            "text": "列少量愿意做的企业职责，逐条对照已有任务与缺口；把税前期望与到手底线分开。",
            "date": "{{k:/context/personal_dates/action0}}"
          },
          {
            "text": "用国考具体职位核专业、学历学位、应届和基层经历；若没有明确可报且愿去的职位，不因怕错过而报名。",
            "date": "{{k:/context/personal_dates/action1}}"
          },
          {
            "text": "与家庭确认短期支持和应急金边界；复核电网单位公告窗口，确定主线及可承受的考试准备。",
            "date": "{{k:/context/personal_dates/action2}}"
