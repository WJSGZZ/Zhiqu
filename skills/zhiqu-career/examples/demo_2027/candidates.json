  "report_blocks": {
    "06_2": {
      "type": "candidate_table",
      "content": {
        "columns": [
          "调查目标",
          "应核的硬门槛",
          "小宁目前匹配",
          "需要补的证据或退出条件"
        ],
        "rows": [
          [
            "有带教的会计助理",
            "是否接受专科、大数据与会计、{{k:/target_year}} 毕业；证书与到岗要求",
            "△专业相关、有基础实习",
            "正式岗位原文、带教安排、实际财务产出；若仅做本人拒绝的销售则 ✗"
          ],
          [
            "权限清楚的出纳",
            "学历、证书、资金职责、岗位交接与复核",
            "△细致、有流程偏好，独立资金管理未证实",
            "不将性格代替能力；审批责任不清时先停核"
          ],
          [
            "应收应付或财务文员",
            "Excel、业务流程、沟通、是否要求相关经历",
            "△有录入经验、熟练程度待验证",
            "对照实际任务做一次核对，不能把基础水平写成熟练"
          ],
          [
            "国企财务相关机会",
            "具体单位学历、专业、毕业窗口、考试与签约要求",
            "△能投实习原文已取，学历字段冲突；不认定可报名",
            "先问清本科与专科矛盾；实习不等同直接就业，不扩大为国企都不能报"
          ],
          [
            "国企用工单位的派遣岗",
            "派遣甲方、用工单位、岗位资格、派遣安排与待遇",
            "△情景中存在这一类型，现实机会未取得",
            "不能称已获国企正式员工身份，不计口头转直签承诺"
          ],
          [
            "事业单位财务相关岗",
            "当年岗位表学历、专业、证书、年龄与其他要求",
            "△未取得适用{{k:/target_year}}岗位",
            "先判资格，再谈考试；不把任何事业单位公告当专科会计通用入口"
          ],
          [
            "普通专升本",
            "{{k:/target_year}} 省内资格、专业对应、计划与资金",
            "△高职在读，具体当届条件待核",
            "不是招聘岗位；只有能解除目标门槛且投入可承受才提高优先级"
          ]
        ]
      },
      "evidence_refs": [
        "E0001"
      ]
    }
  }
