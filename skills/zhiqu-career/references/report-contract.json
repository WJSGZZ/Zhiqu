{
 "schema_version": 1,
 "shared_rules": "../../zhiqu-shared/references/report-workflow.md",
 "narrative_policy": {
  "only_registered_keys": true,
  "no_handwritten_markdown_report": true,
  "numeric_tokens": [
   "{{e:E001#/value}}",
   "{{c:/annual_cost}}",
   "{{k:/target_year}}",
   "{{p:/fields/0/value}}"
  ]
 },
 "publication_gates": [
  "contract",
  "numeric_trace",
  "render",
  "layout",
  "long_urls",
  "svg_title_and_source"
 ],
 "trace_policy": {
  "evidence_file": "evidence.json",
  "calculation_file": "calculations.json",
  "trace_file": "report_trace.json",
  "semantic_numbers_require_refs": true,
  "structural_numbers": [
   "section_number",
   "source_number",
   "page_number",
   "report_id"
  ],
  "urls_only_in_section": "12",
  "registration_files": [
   "case.json",
   "profile_parse.json"
  ],
  "exempt": [
   "section_number",
   "source_number",
   "page_number",
   "report_id",
   "report_count",
   "ordinal",
   "list_number"
  ]
 },
 "matrix_policy": {
  "min_options": 3,
  "min_dimensions": 4,
  "unknown_ratio_explanation_above": 0.7,
  "unknown_explanation_fields": [
   "missing_information",
   "retrieval_plan",
   "decision_changes"
  ]
 },
 "figure_policy": {
  "required": [
   "title",
   "caption",
   "source_refs"
  ],
  "missing_data": "one_line_gap_with_missing_source_and_expected_date_no_empty_figures"
 },
 "source_numbering": "stable_evidence_ids_in_first_use_order",
 "review_policy": "shared_rules#六复核与评分",
 "kind": "career",
 "section_count": 12,
 "context_fields": [
  "offer_basis",
  "as_of"
 ],
