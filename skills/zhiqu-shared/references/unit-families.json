  "legacy_demo_output_schema": [
    {
      "path_regex": "^/(age_at_decision|age_at_target)$",
      "unit": "岁"
    },
    {
      "path_regex": "^/luck_start_year$",
      "unit": "年份"
    },
    {
      "path_regex": "^/(annual_cost|annual_margin|annual_cost_if_living_plus_200|annual_margin_if_living_plus_200)$",
      "unit": "元/年"
    },
    {
      "path_regex": "^/total_cost_over_program$",
      "unit": "元"
    },
    {
      "path_regex": "^/gdut_fee_reference/(annual_cost|annual_margin|annual_cost_if_living_plus_200|annual_margin_if_living_plus_200)$",
      "unit": "元/年"
    },
    {
      "path_regex": "^/gdut_fee_reference/total_cost$",
      "unit": "元"
    },
    {
      "path_regex": "^/gdut_2026_retest/(initial_increment_contribution|retest_increment_contribution)$",
      "unit": "分"
    },
    {
      "path_regex": "^/gdut_2026_first_choice_retest_scores/(min|q1|median|q3|max)$",
      "unit": "分"
    },
    {
      "path_regex": "^/gdut_2026_first_choice_retest_scores/n$",
      "unit": "人"
    },
    {
      "path_regex": "^/sample_reconciliation_2025/(total|minority|soldier|joint|ordinary)$",
      "unit": "人"
    },
    {
      "path_regex": "^/(monthly_expenses|monthly_remaining|monthly_remaining_if_housing_plus_600)$",
      "unit": "元/月"
    },
    {
      "path_regex": "^/hypothetical_offers/[0-9]+/(annual_gross|personal_social_insurance|personal_housing_fund|housing_fund_account_total|tax|annual_take_home_cash)$",
      "unit": "元/年"
    },
    {
      "path_regex": "^/hypothetical_offers/[0-9]+/(social_insurance_base|monthly_take_home_cash|monthly_remaining_cash)$",
      "unit": "元/月"
    },
    {
      "path_regex": "^/hypothetical_offers/[0-9]+/(hourly_cash|hourly_if_housing_fund_counted)$",
      "unit": "元/小时"
    },
    {
      "path_regex": "^/hypothetical_offers/[0-9]+/hours_per_year$",
      "unit": "小时/年"
    },
    {
      "path_regex": "^/offer_b_ordinary_month/(take_home_cash|remaining_cash)$",
      "unit": "元/月"
    },
    {
      "path_regex": "^/reference_wages_cny/[^/]+/(p10|p25|p50|p75|p90)$",
      "unit": "元/年"
    },
    {
      "path_regex": "^/scut_reference_statistics/[^/]+/(min|q1|median|q3|max)$",
      "unit": "分"
    },
    {
      "path_regex": "^/scut_reference_statistics/[^/]+/n$",
      "unit": "人"
    },
    {
      "path_regex": "^/report_constants/(q1_label|q3_label|p10_label|p90_label)$",
      "unit": "%"
    },
    {
      "path_regex": "^/report_constants/months_per_year$",
      "unit": "月/年"
    },
    {
      "path_regex": "^/report_constants/living_increment$",
      "unit": "元/月"
    }
  ]
